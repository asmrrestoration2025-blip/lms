# Supabase — obtain from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase project ID for type generation
SUPABASE_PROJECT_ID=your-project-id

# Superadmin bootstrap — set only for initial bootstrap, remove after
# BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
# BOOTSTRAP_SUPERADMIN_PASSWORD=change-me
